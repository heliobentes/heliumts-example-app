# Only HELIUM_PUBLIC_ variables are exposed directly to the browser.
HELIUM_PUBLIC_APP_NAME="Helium Example App"
HELIUM_PUBLIC_API_URL="http://localhost:3000/api"
HELIUM_PUBLIC_FEATURE_FLAG="true"

# Use a local development database. MongoDB 7+ is recommended.
MONGODB_URI="mongodb://127.0.0.1:27017/helium-example"
API_SECRET_KEY=""

# Generate a distinct random secret of at least 32 characters before enabling auth.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Register http://localhost:3000/api/auth/callback/google in Google OAuth.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Generate a separate random secret for production or multiple instances.
HELIUM_SECRET=""
# 0 = direct connection; otherwise the exact number of trusted reverse proxies.
TRUST_PROXY_DEPTH=0
