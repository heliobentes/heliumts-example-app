{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "jsx": "react-jsx",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "noEmit": true,
        "skipLibCheck": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "types": ["node", "vite/client"]
    },
    "include": ["src", "vite.config.ts", "helium.config.ts"]
}
